
@article{eaton_ipyrad_2020,
	title = {ipyrad: {Interactive} assembly and analysis of {RADseq} datasets},
	issn = {1367-4803, 1460-2059},
	shorttitle = {ipyrad},
	url = {https://academic.oup.com/bioinformatics/advance-article/doi/10.1093/bioinformatics/btz966/5697088},
	doi = {10.1093/bioinformatics/btz966},
	abstract = {Summary: ipyrad is a free and open source tool for assembling and analyzing restriction-site associated DNA sequence (RADseq) datasets using de novo and/or reference-based approaches. It is designed to be massively scalable to hundreds of taxa and thousands of samples, and can be efficiently parallelized on high performance computing clusters. It is available as both a command line interface (CLI) and as a Python package with an application programming interface (API), the latter of which can be used interactively to write complex, reproducible scripts, and implement a suite of downstream analysis tools.},
	language = {en},
	urldate = {2020-01-10},
	journal = {Bioinformatics},
	author = {Eaton, Deren A R and Overcast, Isaac},
	editor = {Schwartz, Russell},
