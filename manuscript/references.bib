	author = {Chambers, Kenton L.},
	month = jul,
	year = {2018},
	note = {Number: 1},
	pages = {17--23},
	file = {Full Text PDF:/home/deren/Zotero/storage/BVT2SM4S/Chambers - 2018 - Some comments on the taxonomy of Delphinium (Ranunculaceae) in western Oregon.pdf:application/pdf},
}

